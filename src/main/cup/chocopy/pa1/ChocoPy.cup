import java.util.ArrayList;
import java.util.List;
import java_cup.runtime.*;
import chocopy.common.astnodes.*;

parser code {:
    public final Errors errors = new Errors(new ArrayList<CompilerError>());

    private class IfTail {
        final List<Stmt> body;
        final ComplexSymbolFactory.Location end;

        IfTail(List<Stmt> body, ComplexSymbolFactory.Location end) {
            this.body = body;
            this.end = end;
        }
    }

    private class FunctionBody {
        final List<Declaration> declarations = new ArrayList<Declaration>();
        final List<Stmt> statements = new ArrayList<Stmt>();
    }

    public Program parseProgram(boolean debug) {
        try {
            Symbol result = debug ? debug_parse() : parse();
            if (result != null && result.value instanceof Program) {
                return (Program) result.value;
            }
            return new Program(new Location(0, 0), new Location(0, 0),
                               new ArrayList<Declaration>(), new ArrayList<Stmt>(), errors);
        } catch (RuntimeException excp) {
            throw excp;
        } catch (Exception excp) {
            throw new AssertionError(String.format("Internal parser error detected: %s%n", excp));
        }
    }

    @Override
    public SymbolFactory getSymbolFactory() {
        return ((ChocoPyLexer) getScanner()).symbolFactory;
    }

    @Override
    public void syntax_error(Symbol cur_token) {
        String token = symbl_name_from_id(cur_token.sym);
        String text = cur_token.value instanceof String
                && ((String) cur_token.value).equals("<bad indentation>")
            ? (String) cur_token.value : ((ChocoPyLexer) getScanner()).yytext();
        errors.syntaxError(((ComplexSymbolFactory.ComplexSymbol) cur_token).xleft,
                           ((ComplexSymbolFactory.ComplexSymbol) cur_token).xright,
                           "Parse error near token %s: %s", token, text);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) { }
:}

action code {:
    <T> List<T> one(T item) {
        List<T> result = new ArrayList<T>();
        if (item != null) result.add(item);
        return result;
    }

    <T> List<T> append(List<T> items, T item) {
        if (item != null) items.add(item);
        return items;
    }

    <T> List<T> empty() { return new ArrayList<T>(); }

    ComplexSymbolFactory.Location left(List<? extends Node> nodes) {
        if (nodes == null || nodes.isEmpty()) return null;
        int[] loc = nodes.get(0).getLocation();
        return new ComplexSymbolFactory.Location(loc[0], loc[1]);
    }

    ComplexSymbolFactory.Location right(List<? extends Node> nodes) {
        if (nodes == null || nodes.isEmpty()) return null;
        int[] loc = nodes.get(nodes.size() - 1).getLocation();
        return new ComplexSymbolFactory.Location(loc[2], loc[3]);
    }
:}

terminal NEWLINE, INDENT, DEDENT, UNRECOGNIZED, INVALID_TYPE_STRING, RESERVED, PASS, END_OF_INPUT;
terminal String ID, STRING;
terminal PLUS, MINUS, MULT, DIV, MOD, LT, GT, LE, GE, EQ, NE, ASSIGN;
terminal COLON, COMMA, DOT, LPAREN, RPAREN, LBRACKET, RBRACKET;
terminal IF, ELSE, ELIF, WHILE, FOR, IN, DEF, CLASS, RETURN, GLOBAL, NONLOCAL;
terminal AND, OR, NOT, IS, TRUE, FALSE, NONE, ARROW;
terminal Integer NUMBER;
terminal UMINUS;

non terminal Program start_program;
non terminal List<Declaration> decl_list;
non terminal List<Declaration> class_decl_list;
non terminal FunctionBody function_body;
non terminal Declaration class_member, function_declaration;
non terminal List<Stmt> statements;
non terminal List<Stmt> optional_statements;
non terminal IfTail if_tail;
non terminal List<TypedVar> parameters;
non terminal List<Expr> expressions;
non terminal List<Expr> arguments;
non terminal List<Expr> assignment_targets;
non terminal Expr assignment_target;
non terminal Declaration declaration, function_definition;
non terminal Stmt statement, simple_statement, compound_statement;
non terminal Expr expression, conditional_expression, or_expression, and_expression;
non terminal Expr not_expression, comparison, arithmetic, term, factor, atom, postfix;
non terminal Literal literal;
non terminal TypeAnnotation type;
non terminal TypeAnnotation optional_return_type;
non terminal TypedVar typed_variable;

precedence left OR;
precedence left ID;
precedence left LPAREN;
precedence left AND;
precedence right NOT;
precedence nonassoc LT, GT, LE, GE, EQ, NE, IS;
precedence left PLUS, MINUS;
precedence left MULT, DIV, MOD;
precedence right UMINUS;

start with start_program;

start_program ::= decl_list:d optional_statements:s END_OF_INPUT:eof
    {: boolean hasTopLevelStatements = !s.isEmpty()
           || (sxleft != null && sxleft.getLine() > 0);
       ComplexSymbolFactory.Location programLeft = !d.isEmpty() ? left(d)
           : (hasTopLevelStatements ? sxleft : new ComplexSymbolFactory.Location(0, 0));
       ComplexSymbolFactory.Location programRight = hasTopLevelStatements ? sxright
           : (!d.isEmpty() ? dxright : new ComplexSymbolFactory.Location(0, 0));
       RESULT = new Program(programLeft, programRight, d, s, errors); :}
    ;

decl_list ::= /* empty declaration list */
    {: RESULT = empty(); :}
    | decl_list:ds declaration:d {: RESULT = append(ds, d); :}
    ;

declaration ::= typed_variable:v ASSIGN literal:value NEWLINE
    {: RESULT = new VarDef(vxleft, valuexright, v, value); :}
    | GLOBAL:g ID:name NEWLINE
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new GlobalDecl(gxleft, namexright, id); :}
    | GLOBAL:g NEWLINE
    {: errors.syntaxError(gxleft, gxright, "Parse error near token GLOBAL: global");
       RESULT = null; :}
    | NONLOCAL:n ID:name NEWLINE
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new NonLocalDecl(nxleft, namexright, id); :}
    | NONLOCAL:n NEWLINE
    {: errors.syntaxError(nxleft, nxright, "Parse error near token NONLOCAL: nonlocal");
       RESULT = null; :}
    | function_definition:f
    {: RESULT = f; :}
    | CLASS error NEWLINE INDENT class_decl_list:members DEDENT
    {: RESULT = null; :}
    | CLASS:c ID:name LPAREN ID:parent RPAREN COLON NEWLINE INDENT class_decl_list:members DEDENT
    {: Identifier id = new Identifier(namexleft, namexright, name);
       Identifier sup = new Identifier(parentxleft, parentxright, parent);
       RESULT = new ClassDef(cxleft, membersxright, id, sup, members); :}
    | CLASS:c ID:name LPAREN ID:parent RPAREN COLON NEWLINE INDENT PASS NEWLINE:pass_end DEDENT:end
    {: Identifier id = new Identifier(namexleft, namexright, name);
       Identifier sup = new Identifier(parentxleft, parentxright, parent);
       RESULT = new ClassDef(cxleft, pass_endxright, id, sup, empty()); :}
    ;

class_decl_list ::= class_member:member
    {: RESULT = one(member); :}
    | class_decl_list:members class_member:member
    {: RESULT = append(members, member); :}
    | error NEWLINE
    {: RESULT = empty(); :}
    | class_decl_list:members error NEWLINE
    {: RESULT = members; :}
    ;

class_member ::= typed_variable:v ASSIGN literal:value NEWLINE
    {: RESULT = new VarDef(vxleft, valuexright, v, value); :}
    | function_definition:f
    {: RESULT = f; :}
    ;

function_definition ::= DEF:d ID:name LPAREN parameters:params RPAREN optional_return_type:ret COLON:c NEWLINE INDENT function_body:body DEDENT:end
    {: Identifier id = new Identifier(namexleft, namexright, name);
       TypeAnnotation returnType = ret == null
           ? new ClassType(cxleft, cxleft, "<None>") : ret;
       RESULT = new FuncDef(dxleft, bodyxright, id, params, returnType,
                            body.declarations, body.statements); :}
    | DEF error NEWLINE INDENT function_body:body DEDENT
    {: RESULT = null; :}
    ;

optional_return_type ::= {: RESULT = null; :}
    | ARROW type:t {: RESULT = t; :}
    ;

function_body ::= function_declaration:declaration function_body:body
    {: body.declarations.add(0, declaration); RESULT = body; :}
    | statement:first optional_statements:rest
    {: FunctionBody body = new FunctionBody();
       if (first != null) body.statements.add(first);
       body.statements.addAll(rest);
       RESULT = body; :}
    ;

function_declaration ::= typed_variable:v ASSIGN literal:value NEWLINE
    {: RESULT = new VarDef(vxleft, valuexright, v, value); :}
    | GLOBAL:g ID:name NEWLINE
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new GlobalDecl(gxleft, namexright, id); :}
    | NONLOCAL:n ID:name NEWLINE
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new NonLocalDecl(nxleft, namexright, id); :}
    | function_definition:f
    {: RESULT = f; :}
    ;

parameters ::= {: RESULT = empty(); :}
    | typed_variable:v {: RESULT = one(v); :}
    | parameters:ps COMMA typed_variable:v {: RESULT = append(ps, v); :}
    ;

typed_variable ::= ID:name COLON type:t
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new TypedVar(namexleft, txright, id, t); :}
    ;

type ::= ID:name
    {: RESULT = new ClassType(namexleft, namexright, name); :}
    | STRING:name
    {: if (!name.matches("[A-Za-z_][A-Za-z_0-9]*")) {
           errors.syntaxError(namexleft, namexright,
                              "Parse error near token STRING: invalid type name");
       }
       RESULT = new ClassType(namexleft, namexright, name); :}
    | LBRACKET:l type:t RBRACKET:r
    {: RESULT = new ListType(lxleft, rxright, t); :}
    ;

optional_statements ::= {: RESULT = empty(); :}
    | statements:s {: RESULT = s; :}
    ;

statements ::= statement:s {: RESULT = one(s); :}
    | statements:ss statement:s {: RESULT = append(ss, s); :}
    ;

statement ::= simple_statement:s NEWLINE {: RESULT = s; :}
    | compound_statement:s {: RESULT = s; :}
    | PASS NEWLINE {: RESULT = null; :}
    | error NEWLINE {: RESULT = null; :}
    ;

simple_statement ::= expression:e
    {: RESULT = new ExprStmt(exleft, exright, e); :}
    | RETURN:r expression:e
    {: RESULT = new ReturnStmt(rxleft, exright, e); :}
    | RETURN:r
    {: RESULT = new ReturnStmt(rxleft, rxright, null); :}
    | assignment_targets:targets ASSIGN expression:value
    {: RESULT = new AssignStmt(left(targets), valuexright, targets, value); :}
    ;

assignment_targets ::= assignment_target:e {: RESULT = one(e); :}
    | assignment_targets:targets ASSIGN assignment_target:e {: RESULT = append(targets, e); :}
    ;

assignment_target ::= ID:name
    {: RESULT = new Identifier(namexleft, namexright, name); :}
    | postfix:object DOT ID:name
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new MemberExpr(objectxleft, namexright, object, id); :}
    | postfix:object LBRACKET expression:index RBRACKET:r
    {: RESULT = new IndexExpr(objectxleft, rxright, object, index); :}
    ;

compound_statement ::= IF:i expression:condition COLON NEWLINE INDENT statements:then_body DEDENT:then_end if_tail:tail
    {: ComplexSymbolFactory.Location nodeEnd = tail.end == null ? then_endxright : tail.end;
       RESULT = new IfStmt(ixleft, nodeEnd, condition, then_body, tail.body); :}
    | WHILE:w expression:condition COLON NEWLINE INDENT statements:body DEDENT:end
    {: RESULT = new WhileStmt(wxleft, endxright, condition, body); :}
    | FOR:f ID:name IN expression:iterable COLON NEWLINE INDENT statements:body DEDENT:end
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new ForStmt(fxleft, endxright, id, iterable, body); :}
    ;

if_tail ::= {: RESULT = new IfTail(empty(), null); :}
    | ELSE COLON NEWLINE INDENT statements:body DEDENT:end
    {: RESULT = new IfTail(body, endxright); :}
    | ELIF:i expression:condition COLON NEWLINE INDENT statements:body DEDENT:body_end if_tail:tail
    {: ComplexSymbolFactory.Location nodeEnd = tail.end == null ? body_endxright : tail.end;
       IfStmt nested = new IfStmt(ixleft, nodeEnd, condition, body, tail.body);
       RESULT = new IfTail(one(nested), nodeEnd); :}
    ;

expression ::= conditional_expression:e {: RESULT = e; :};
conditional_expression ::= or_expression:e {: RESULT = e; :}
    | or_expression:then_expr IF conditional_expression:condition ELSE conditional_expression:else_expr
    {: RESULT = new IfExpr(then_exprxleft, else_exprxright, condition, then_expr, else_expr); :}
    ;

or_expression ::= and_expression:e {: RESULT = e; :}
    | or_expression:left_expr OR and_expression:right_expr
    {: RESULT = new BinaryExpr(left_exprxleft, right_exprxright, left_expr, "or", right_expr); :}
    ;
and_expression ::= not_expression:e {: RESULT = e; :}
    | and_expression:left_expr AND not_expression:right_expr
    {: RESULT = new BinaryExpr(left_exprxleft, right_exprxright, left_expr, "and", right_expr); :}
    ;
not_expression ::= comparison:e {: RESULT = e; :}
    | NOT:n not_expression:e {: RESULT = new UnaryExpr(nxleft, exright, "not", e); :}
    ;

comparison ::= arithmetic:e {: RESULT = e; :}
    | arithmetic:l LT arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "<", r); :}
    | arithmetic:l GT arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, ">", r); :}
    | arithmetic:l LE arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "<=", r); :}
    | arithmetic:l GE arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, ">=", r); :}
    | arithmetic:l EQ arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "==", r); :}
    | arithmetic:l NE arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "!=", r); :}
    | arithmetic:l IS arithmetic:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "is", r); :}
    ;

arithmetic ::= term:e {: RESULT = e; :}
    | arithmetic:l PLUS term:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "+", r); :}
    | arithmetic:l MINUS term:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "-", r); :}
    ;
term ::= factor:e {: RESULT = e; :}
    | term:l MULT factor:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "*", r); :}
    | term:l DIV factor:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "//", r); :}
    | term:l MOD factor:r {: RESULT = new BinaryExpr(lxleft, rxright, l, "%", r); :}
    ;
factor ::= atom:e {: RESULT = e; :}
    | MINUS:m factor:e {: RESULT = new UnaryExpr(mxleft, exright, "-", e); :}
      %prec UMINUS
    ;

atom ::= postfix:e {: RESULT = e; :}
    ;

postfix ::= ID:name
    {: RESULT = new Identifier(namexleft, namexright, name); :}
    | literal:l {: RESULT = l; :}
    | LPAREN expression:e RPAREN {: RESULT = e; :}
    | LBRACKET:l expressions:items RBRACKET:r
    {: RESULT = new ListExpr(lxleft, rxright, items); :}
    | LBRACKET:l RBRACKET:r
    {: RESULT = new ListExpr(lxleft, rxright, empty()); :}
    | ID:name LPAREN arguments:args RPAREN:r
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new CallExpr(namexleft, rxright, id, args); :}
    | postfix:object DOT ID:name
    {: Identifier id = new Identifier(namexleft, namexright, name);
       RESULT = new MemberExpr(objectxleft, namexright, object, id); :}
    | postfix:object LBRACKET expression:index RBRACKET:r
    {: RESULT = new IndexExpr(objectxleft, rxright, object, index); :}
    | postfix:method DOT ID:name LPAREN arguments:args RPAREN:r
    {: Identifier id = new Identifier(namexleft, namexright, name);
       MemberExpr member = new MemberExpr(methodxleft, namexright, method, id);
       RESULT = new MethodCallExpr(methodxleft, rxright, member, args); :}
    ;

arguments ::= {: RESULT = empty(); :}
    | expressions:items {: RESULT = items; :}
    ;

expressions ::= expression:e {: RESULT = one(e); :}
    | expressions:items COMMA expression:e {: RESULT = append(items, e); :}
    ;

literal ::= NUMBER:n {: RESULT = new IntegerLiteral(nxleft, nxright, n); :}
    | STRING:s {: RESULT = new StringLiteral(sxleft, sxright, s); :}
    | TRUE:t {: RESULT = new BooleanLiteral(txleft, txright, true); :}
    | FALSE:f {: RESULT = new BooleanLiteral(fxleft, fxright, false); :}
    | NONE:n {: RESULT = new NoneLiteral(nxleft, nxright); :}
    ;
