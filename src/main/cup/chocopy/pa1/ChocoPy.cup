import java.util.ArrayList;
import java.util.List;

import java_cup.runtime.*;
import chocopy.common.astnodes.*;

/* The following code section is copied verbatim to the generated
 * parser class. */
parser code {:

    /* The following fields and methods deal with error reporting
     * Avoid changing these unless you know what you are doing. */

    /** Node that accumulates error messages to be added to the Program
     *  node produced as a result. */
    public final Errors errors = new Errors(new ArrayList<>());

    /** Return the Program node that results from parsing the stream of
     *  tokens produced by lexical analysis.  In the case of syntax errors,
     *  the program may be empty, but will have error messages. */
    public Program parseProgram(boolean debug) {
        try {
            Symbol result = debug ? debug_parse() : parse();
            if (result == null || !(result.value instanceof Program)) {
                return new Program(new Location(0, 0), new Location(0, 0),
                                   new ArrayList<Declaration>(),
                                   new ArrayList<Stmt>(),
                                   errors);
            } else {
                return (Program) result.value;
            }
        } catch (RuntimeException excp) {
            throw excp;
        } catch (Exception excp) {
            String msg =
                String.format("Internal parser error detected: %s%n", excp);
            throw new AssertionError(msg);
        }
    }

    @Override
    public SymbolFactory getSymbolFactory() {
        return ((ChocoPyLexer) getScanner()).symbolFactory;
    }

    @Override
    public void syntax_error(Symbol cur_token) {
                String token = symbl_name_from_id(cur_token.sym);
                String text = ((ChocoPyLexer) getScanner()).yytext();
                errors.syntaxError(
                    ((ComplexSymbolFactory.ComplexSymbol) cur_token).xleft,
                    ((ComplexSymbolFactory.ComplexSymbol) cur_token).xright,
                    "Parse error near token %s: %s", token, text);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) {
        /* Do not die */
    }
:}


/**************************************************************************
 * ChocoPy grammar (Figure 3 of the ChocoPy reference manual), written for
 * the LALR(1) parser generator CUP.
 *
 * Design notes:
 *  - Expressions use an ambiguous grammar (e.g. cexpr ::= cexpr + cexpr)
 *    and the precedence declarations below resolve the resulting
 *    shift/reduce conflicts, as in operator-precedence LR parsing.
 *  - The expr / cexpr split of the manual is kept, so that `not`, `and`,
 *    `or` and `if-else` can only take logical operands; e.g.
 *    `True == not False` is a syntax error.
 *  - The location of every AST node runs from the left end of its leftmost
 *    symbol to the right end of its rightmost symbol.  Statements end
 *    before their NEWLINE, but the CUP symbol of a statement extends over
 *    the NEWLINE (or over the DEDENT closing its block), which is what the
 *    enclosing function and class definitions use as their end.
 *  - Error recovery uses CUP's `error` symbol, see `recovery` below.
 *  - CUP reports no conflicts: the only ones (operators, and the error
 *    recovery after a DEDENT) are resolved by precedence declarations.
 **************************************************************************/


/* The following code section is copied verbatim to the class that performs
 * production-rule actions. */
action code {:

    /** The declarations and statements of a program or function body. */
    class Body {
        final List<Declaration> declarations;
        final List<Stmt> statements;

        Body(List<Declaration> declarations, List<Stmt> statements) {
            this.declarations = declarations;
            this.statements = statements;
        }
    }

    /** Return a mutable list initially containing the single value ITEM. */
    <T> List<T> single(T item) {
        List<T> list = new ArrayList<>();
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** If ITEM is non-null, appends it to the end of LIST.  Then returns
     *  LIST. */
    <T> List<T> combine(List<T> list, T item) {
        if (item != null) {
            list.add(item);
        }
        return list;
    }

    /** If ITEM is non-null, inserts it at the front of LIST.  Then returns
     *  LIST.  Used by the right-recursive list rules. */
    <T> List<T> prepend(T item, List<T> list) {
        if (item != null) {
            list.add(0, item);
        }
        return list;
    }

    /** Return a mutable empty list. */
    <T> List<T> empty() {
        return new ArrayList<T>();
    }

    /** Return BODY after inserting DECL in front of its declarations. */
    Body prependDeclaration(Declaration decl, Body body) {
        prepend(decl, body.declarations);
        return body;
    }

:}

/* ------------------------------------------------------------------------
 * Terminal symbols (tokens returned by the lexer).
 * ------------------------------------------------------------------------ */

/* Line structure. */
terminal NEWLINE, INDENT, DEDENT;

/* Identifiers and literals. */
terminal String  IDENTIFIER;
terminal String  IDSTRING, STRING;       /* value: unescaped contents */
terminal Integer INTEGER;
terminal Boolean TRUE, FALSE;
terminal NONE;

/* Keywords. */
terminal CLASS, DEF, GLOBAL, NONLOCAL, PASS, RETURN;
terminal IF, ELIF, ELSE, WHILE, FOR, IN;
terminal String AND, OR, NOT, IS;

/* Python keywords that ChocoPy reserves but never uses. */
terminal RESERVED;

/* Operators (value: the operator text). */
terminal String PLUS, MINUS, TIMES, IDIV, MOD;
terminal String EQEQ, NEQ, LT, GT, LEQ, GEQ;

/* Delimiters. */
terminal EQ, LPAREN, RPAREN, LINDEX, RINDEX, COMMA, COLON, DOT, ARROW;

/* Returned by the lexer for erroneous tokens.  Since it does not appear in
 * the grammar, it indicates a syntax error. */
terminal UNRECOGNIZED;

/* Pseudo-terminal used only to give unary minus its own precedence. */
terminal UMINUS;

/* ------------------------------------------------------------------------
 * Nonterminal symbols.
 * ------------------------------------------------------------------------ */

non terminal Program              program;
non terminal Body                 program_body, func_body;
non terminal Declaration          top_level_decl, func_decl, class_decl;
non terminal List<Declaration>    class_body, class_decls;
non terminal ClassDef             class_def;
non terminal FuncDef              func_def;
non terminal VarDef               var_def;
non terminal GlobalDecl           global_decl;
non terminal NonLocalDecl         nonlocal_decl;
non terminal TypedVar             typed_var;
non terminal List<TypedVar>       opt_params, params;
non terminal TypeAnnotation       type, opt_return_type;

non terminal List<Stmt>           stmts, block_stmts, block, else_part;
non terminal Stmt                 stmt, simple_stmt;
non terminal List<Expr>           targets;
non terminal Expr                 target;

non terminal Expr                 expr, cexpr;
non terminal MemberExpr           member_expr;
non terminal IndexExpr            index_expr;
non terminal List<Expr>           opt_exprs, exprs;
non terminal Literal              literal;
non terminal Identifier           identifier;

non terminal                      recovery, skipped_body, dedent;

/* ------------------------------------------------------------------------
 * Precedences, from lowest to highest (Section 4.1 of the manual).
 * ------------------------------------------------------------------------ */

precedence right IF, ELSE;                        /* e1 if c else e2   */
precedence left  OR;
precedence left  AND;
precedence right NOT;
precedence nonassoc EQEQ, NEQ, LT, GT, LEQ, GEQ, IS; /* no a < b < c   */
precedence left  PLUS, MINUS;
precedence left  TIMES, IDIV, MOD;
precedence right UMINUS;                          /* -e                */
precedence left  DOT, LINDEX;                     /* e.f   e[i]        */

/* Used only to let a broken line right after a block be recovered at the
 * end of that block (see `dedent`): shifting `error` wins over reducing. */
precedence left  DEDENT;
precedence left  error;

/* The start symbol. */
start with program;


/*****  GRAMMAR RULES *****/

/* ========================================================================
 * Program structure:  program ::= [var_def | func_def | class_def]* stmt*
 *
 * The bodies of programs and functions are right-recursive sequences
 * "declarations, then statements".  Written this way, every position
 * at which a declaration or statement may start has exactly one rule that
 * can shift `error`, so recovery needs no extra conflict resolution:
 *   - before (or instead of) a declaration:  `recovery program_body`,
 *     after which further declarations are still accepted;
 *   - after the first statement:              `recovery stmts`.
 * ======================================================================== */

program ::= program_body:body
        {: RESULT = new Program(bodyxleft, bodyxright, body.declarations,
                                body.statements, errors);
        :}
        ;

program_body ::= /* empty */
        {: RESULT = new Body(empty(), empty()); :}
               | top_level_decl:d program_body:body
        {: RESULT = prependDeclaration(d, body); :}
               | recovery program_body:body
        {: RESULT = body; :}
               | stmt:s stmts:rest
        {: RESULT = new Body(empty(), prepend(s, rest)); :}
               ;

top_level_decl ::= var_def:d               {: RESULT = d; :}
                 | func_def:d              {: RESULT = d; :}
                 | class_def:d             {: RESULT = d; :}
                 ;

/* ========================================================================
 * Error recovery.
 *
 * A syntax error inside a line skips the rest of that line.  If the
 * broken line was the header of a compound construct (def, class, if,
 * ...) its indented body is parsed and then dropped, so that errors
 * inside the body are still reported and the following lines are not
 * misread as code of the enclosing block.
 * ======================================================================== */

recovery ::= error NEWLINE
           | error NEWLINE INDENT skipped_body dedent
           | error INDENT skipped_body dedent    /* unexpected indentation */
           ;

/* The end of an indented body.  If the line right after the body starts
 * with a token that cannot start anything (e.g. `break` or `$`), the
 * parser cannot reduce the body, because LR reductions need a valid
 * lookahead.  Plain CUP recovery would then pop the DEDENT and resume
 * inside the body, leaving the blocks unbalanced up to EOF.  The second
 * alternative recovers that line right here instead. */
dedent ::= DEDENT
         | DEDENT recovery
         ;

/* Anything that may appear in the body of a function, class or block. */
skipped_body ::= /* empty */
               | func_decl skipped_body
               | class_def skipped_body
               | recovery skipped_body
               | stmt stmts
               ;

/* ========================================================================
 * Class definitions.
 * ======================================================================== */

class_def ::= CLASS:c identifier:name LPAREN identifier:superClass RPAREN
              COLON NEWLINE INDENT class_body:body dedent
        {: RESULT = new ClassDef(cxleft, bodyxright, name, superClass, body);
        :}
        ;

class_body ::= PASS NEWLINE                {: RESULT = empty(); :}
             | class_decls:l               {: RESULT = l; :}
             ;

class_decls ::= class_decl:d               {: RESULT = single(d); :}
              | recovery                   {: RESULT = empty(); :}
              | class_decls:l class_decl:d {: RESULT = combine(l, d); :}
              | class_decls:l recovery     {: RESULT = l; :}
              ;

class_decl ::= var_def:d                   {: RESULT = d; :}
             | func_def:d                  {: RESULT = d; :}
             ;

/* ========================================================================
 * Function definitions.
 * ======================================================================== */

func_def ::= DEF:d identifier:name LPAREN opt_params:params RPAREN
             opt_return_type:ret COLON:colon NEWLINE INDENT
             func_body:body dedent
        {: /* Without "-> type" the function returns <None>; that type is
            * reported at the position of the colon. */
           TypeAnnotation returnType = ret != null ? ret
               : new ClassType(colonxleft, colonxright, "<None>");
           RESULT = new FuncDef(dxleft, bodyxright, name, params, returnType,
                                body.declarations, body.statements);
        :}
        ;

opt_params ::= /* empty */                 {: RESULT = empty(); :}
             | params:l                    {: RESULT = l; :}
             ;

params ::= typed_var:v                     {: RESULT = single(v); :}
         | params:l COMMA typed_var:v      {: RESULT = combine(l, v); :}
         ;

opt_return_type ::= /* empty */            {: RESULT = null; :}
                  | ARROW type:t           {: RESULT = t; :}
                  ;

/* Like program_body, but a function needs at least one statement.  A body
 * that ends in a recovered error is accepted, to avoid a second error at
 * its DEDENT. */
func_body ::= func_decl:d func_body:body
        {: RESULT = prependDeclaration(d, body); :}
            | recovery func_body:body
        {: RESULT = body; :}
            | recovery
        {: RESULT = new Body(empty(), empty()); :}
            | stmt:s stmts:rest
        {: RESULT = new Body(empty(), prepend(s, rest)); :}
            ;

func_decl ::= global_decl:d                {: RESULT = d; :}
            | nonlocal_decl:d              {: RESULT = d; :}
            | var_def:d                    {: RESULT = d; :}
            | func_def:d                   {: RESULT = d; :}
            ;

/* ========================================================================
 * Variable definitions, scoping declarations and types.
 * ======================================================================== */

typed_var ::= identifier:id COLON type:t
        {: RESULT = new TypedVar(idxleft, txright, id, t); :}
        ;

type ::= IDENTIFIER:name
        {: RESULT = new ClassType(namexleft, namexright, name); :}
       | IDSTRING:name
        {: RESULT = new ClassType(namexleft, namexright, name); :}
       | LINDEX:l type:element RINDEX:r
        {: RESULT = new ListType(lxleft, rxright, element); :}
       ;

global_decl ::= GLOBAL:g identifier:id NEWLINE
        {: RESULT = new GlobalDecl(gxleft, idxright, id); :}
        ;

nonlocal_decl ::= NONLOCAL:n identifier:id NEWLINE
        {: RESULT = new NonLocalDecl(nxleft, idxright, id); :}
        ;

var_def ::= typed_var:v EQ literal:value NEWLINE
        {: RESULT = new VarDef(vxleft, valuexright, v, value); :}
        ;

/* ========================================================================
 * Statements.
 * ======================================================================== */

/* The statements after the first one of a body or block (right-recursive,
 * see above).  The empty rule only reduces at EOF or DEDENT. */
stmts ::= /* empty */                      {: RESULT = empty(); :}
        | stmt:s stmts:rest                {: RESULT = prepend(s, rest); :}
        | recovery stmts:rest              {: RESULT = rest; :}
        ;

/* `pass` produces no AST node (null is dropped by single/prepend). */
stmt ::= simple_stmt:s NEWLINE             {: RESULT = s; :}
       | IF:i expr:cond COLON block:then
        {: RESULT = new IfStmt(ixleft, thenxright, cond, then, empty()); :}
       | IF:i expr:cond COLON block:then else_part:otherwise
        {: RESULT = new IfStmt(ixleft, otherwisexright,
                               cond, then, otherwise); :}
       | WHILE:w expr:cond COLON block:body
        {: RESULT = new WhileStmt(wxleft, bodyxright, cond, body); :}
       | FOR:f identifier:id IN expr:iterable COLON block:body
        {: RESULT = new ForStmt(fxleft, bodyxright, id, iterable, body); :}
       ;

/* `elif` is syntactic sugar: it becomes an else-body that holds exactly
 * one nested IfStmt, which starts at the `elif` keyword. */
else_part ::= ELSE COLON block:b           {: RESULT = b; :}
            | ELIF:i expr:cond COLON block:then
        {: RESULT = single(new IfStmt(ixleft, thenxright,
                                      cond, then, empty())); :}
            | ELIF:i expr:cond COLON block:then else_part:otherwise
        {: RESULT = single(new IfStmt(ixleft, otherwisexright,
                                      cond, then, otherwise)); :}
            ;

/* A block ends at its DEDENT. */
block ::= NEWLINE INDENT block_stmts:l dedent  {: RESULT = l; :}
        ;

/* A syntax error in the first statement of a block is recovered inside
 * the block, which keeps INDENT and DEDENT balanced. */
block_stmts ::= stmt:s stmts:rest          {: RESULT = prepend(s, rest); :}
              | recovery stmts:rest        {: RESULT = rest; :}
              ;

simple_stmt ::= PASS                       {: RESULT = null; :}
              | expr:e
        {: RESULT = new ExprStmt(exleft, exright, e); :}
              | RETURN:r
        {: RESULT = new ReturnStmt(rxleft, rxright, null); :}
              | RETURN:r expr:e
        {: RESULT = new ReturnStmt(rxleft, exright, e); :}
              | targets:t expr:e
        {: RESULT = new AssignStmt(txleft, exright, t, e); :}
              ;

/* One or more "target =" prefixes, as in  x = y.f = z[0] = 1  */
targets ::= target:t EQ                    {: RESULT = single(t); :}
          | targets:l target:t EQ          {: RESULT = combine(l, t); :}
          ;

target ::= identifier:e                    {: RESULT = e; :}
         | member_expr:e                   {: RESULT = e; :}
         | index_expr:e                    {: RESULT = e; :}
         ;

/* ========================================================================
 * Expressions.
 * ======================================================================== */

/* Logical and conditional expressions. */
expr ::= cexpr:e                           {: RESULT = e; :}
       | NOT:op expr:e
        {: RESULT = new UnaryExpr(opxleft, exright, op, e); :}
       | expr:l AND:op expr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
       | expr:l OR:op expr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
       | expr:then IF expr:cond ELSE expr:otherwise
        {: RESULT = new IfExpr(thenxleft, otherwisexright,
                               cond, then, otherwise); :}
       ;

/* All other expressions. */
cexpr ::= identifier:e                     {: RESULT = e; :}
        | literal:e                        {: RESULT = e; :}
        | LINDEX:l opt_exprs:elements RINDEX:r
        {: RESULT = new ListExpr(lxleft, rxright, elements); :}
        | LPAREN expr:e RPAREN             {: RESULT = e; :}
        | member_expr:e                    {: RESULT = e; :}
        | index_expr:e                     {: RESULT = e; :}
        | member_expr:m LPAREN opt_exprs:args RPAREN:r
        {: RESULT = new MethodCallExpr(mxleft, rxright, m, args); :}
        | identifier:f LPAREN opt_exprs:args RPAREN:r
        {: RESULT = new CallExpr(fxleft, rxright, f, args); :}
        | cexpr:l PLUS:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l MINUS:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l TIMES:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l IDIV:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l MOD:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l EQEQ:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l NEQ:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l LT:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l GT:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l LEQ:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l GEQ:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | cexpr:l IS:op cexpr:r
        {: RESULT = new BinaryExpr(lxleft, rxright, l, op, r); :}
        | MINUS:op cexpr:e
        {: RESULT = new UnaryExpr(opxleft, exright, op, e); :}
          %prec UMINUS
        ;

member_expr ::= cexpr:object DOT identifier:member
        {: RESULT = new MemberExpr(objectxleft, memberxright,
                                   object, member); :}
        ;

index_expr ::= cexpr:list LINDEX expr:index RINDEX:r
        {: RESULT = new IndexExpr(listxleft, rxright, list, index); :}
        ;

opt_exprs ::= /* empty */                  {: RESULT = empty(); :}
            | exprs:l                      {: RESULT = l; :}
            ;

exprs ::= expr:e                           {: RESULT = single(e); :}
        | exprs:l COMMA expr:e             {: RESULT = combine(l, e); :}
        ;

literal ::= NONE:n
        {: RESULT = new NoneLiteral(nxleft, nxright); :}
          | TRUE:b
        {: RESULT = new BooleanLiteral(bxleft, bxright, b); :}
          | FALSE:b
        {: RESULT = new BooleanLiteral(bxleft, bxright, b); :}
          | INTEGER:i
        {: RESULT = new IntegerLiteral(ixleft, ixright, i); :}
          | IDSTRING:s
        {: RESULT = new StringLiteral(sxleft, sxright, s); :}
          | STRING:s
        {: RESULT = new StringLiteral(sxleft, sxright, s); :}
          ;

identifier ::= IDENTIFIER:name
        {: RESULT = new Identifier(namexleft, namexright, name); :}
        ;
